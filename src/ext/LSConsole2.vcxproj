<?xml version="1.0" encoding="utf-8"?>
<Project DefaultTargets="Build" ToolsVersion="Current" xmlns="http://schemas.microsoft.com/developer/msbuild/2003">
  <ItemGroup Label="ProjectConfigurations">
    <ProjectConfiguration Include="Release|x64">
      <Configuration>Release</Configuration>
      <Platform>x64</Platform>
    </ProjectConfiguration>
  </ItemGroup>
  <PropertyGroup Label="Globals">
    <VCProjectVersion>18.0</VCProjectVersion>
    <Keyword>Win32Proj</Keyword>
    <ProjectGuid>{6DA5A62B-34DF-4CBE-8860-7B56ED00CE68}</ProjectGuid>
    <RootNamespace>LSConsole2</RootNamespace>
  </PropertyGroup>
  <Import Project="$(VCTargetsPath)\Microsoft.Cpp.Default.props" />
  <PropertyGroup Label="Configuration">
    <ConfigurationType>DynamicLibrary</ConfigurationType>
    <PlatformToolset>v145</PlatformToolset>
    <!-- ISXDK's headers are written against the ANSI API. -->
    <CharacterSet>MultiByte</CharacterSet>
  </PropertyGroup>
  <Import Project="$(VCTargetsPath)\Microsoft.Cpp.props" />
  <Import Project="..\..\Paths.props" />
  <PropertyGroup>
    <OutDir>$(LSConsole2Out)ext\</OutDir>
    <IntDir>$(LSConsole2Out)obj\ext\</IntDir>
    <TargetName>LSConsole2</TargetName>
    <LinkIncremental>false</LinkIncremental>
  </PropertyGroup>
  <ItemDefinitionGroup>
    <ClCompile>
      <Optimization>MaxSpeed</Optimization>
      <PreprocessorDefinitions>WIN32;NDEBUG;_WINDOWS;_USRDLL;ISX_EXPORTS;NOMINMAX;%(PreprocessorDefinitions)</PreprocessorDefinitions>
      <!-- Static runtime, like other ISXDK extensions: nothing to install alongside the DLL. -->
      <RuntimeLibrary>MultiThreaded</RuntimeLibrary>
      <LanguageStandard>stdcpp17</LanguageStandard>
      <WarningLevel>Level3</WarningLevel>
      <DisableSpecificWarnings>4996</DisableSpecificWarnings>
      <AdditionalIncludeDirectories>$(ISXDKDir)\include;%(AdditionalIncludeDirectories)</AdditionalIncludeDirectories>
      <DebugInformationFormat>ProgramDatabase</DebugInformationFormat>
      <MultiProcessorCompilation>true</MultiProcessorCompilation>
    </ClCompile>
    <Link>
      <SubSystem>Windows</SubSystem>
      <GenerateDebugInformation>true</GenerateDebugInformation>
      <!-- Record only the .pdb's file name, not where it was built (these files are published). -->
      <AdditionalOptions>/PDBALTPATH:%25_PDB%25 %(AdditionalOptions)</AdditionalOptions>
      <AdditionalLibraryDirectories>$(ISXDKDir)\lib64\vs16;%(AdditionalLibraryDirectories)</AdditionalLibraryDirectories>
      <AdditionalDependencies>user32.lib;gdi32.lib;advapi32.lib;cabinet.lib;%(AdditionalDependencies)</AdditionalDependencies>
    </Link>
    <!-- The host's runtime, packed for LSConsole2.rc (tools/pack-runtime.ps1); the solution builds the host first. -->
    <PreBuildEvent>
      <Command>powershell -NoProfile -ExecutionPolicy Bypass -File "$(MSBuildThisFileDirectory)..\..\tools\pack-runtime.ps1" -HostExe "$(LSConsole2Out)host\LSConsole2Host.exe" -Ultralight "$(UltralightDir)" -Page "$(MSBuildThisFileDirectory)..\page" -Stage "$(LSConsole2Out)runtime" -Out "$(LSConsole2Out)runtime.pack"</Command>
      <Message>Packing the host runtime</Message>
    </PreBuildEvent>
    <ResourceCompile>
      <AdditionalIncludeDirectories>$(LSConsole2Out);%(AdditionalIncludeDirectories)</AdditionalIncludeDirectories>
    </ResourceCompile>
  </ItemDefinitionGroup>
  <ItemGroup>
    <ClCompile Include="LSConsole2.cpp" />
    <ClCompile Include="HostLink.cpp" />
    <ClCompile Include="Overlay.cpp" />
    <ClCompile Include="Metadata.cpp" />
    <ClCompile Include="Runtime.cpp" />
    <ClCompile Include="..\common\PipeConn.cpp" />
  </ItemGroup>
  <ItemGroup>
    <ClInclude Include="Console.h" />
    <ClInclude Include="Metadata.h" />
    <ClInclude Include="Runtime.h" />
    <ClInclude Include="..\common\Protocol.h" />
    <ClInclude Include="..\common\PipeConn.h" />
  </ItemGroup>
  <ItemGroup>
    <ResourceCompile Include="LSConsole2.rc" />
  </ItemGroup>
  <Import Project="$(VCTargetsPath)\Microsoft.Cpp.targets" />
</Project>
